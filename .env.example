# Copy to .env (git-ignored) and fill in. Never commit .env.

# --- local PostGIS (docker compose) -------------------------------------------
BBP_LOCAL_DB_PASSWORD=bbp_local
# used by `bbp load` when you run it on the host (outside Docker)
BBP_DATABASE_URL=postgresql://bbp:bbp_local@localhost:5433/cp2b_maps

# --- production database (used only with `bbp load --target prod --yes`) -------
# Supabase (current PILAR-2b database): Project settings > Database > Connection string
#   (use the direct connection or the session pooler, port 5432, with sslmode=require)
# BBP_PROD_DATABASE_URL=postgresql://bbp_loader:<password>@<project>.pooler.supabase.com:5432/postgres?sslmode=require
#
# PostgreSQL on the Unicamp VM through an SSH tunnel (see docs/deployment.md):
#   from the host:            postgresql://bbp_loader:<password>@localhost:5434/cp2b_maps
#   from inside the container: postgresql://bbp_loader:<password>@host.docker.internal:5434/cp2b_maps
# BBP_PROD_DATABASE_URL=

# --- PILAR-2b development database (NewLook docker compose, container cp2b-db-dev) ---
# used by `docker compose run --rm bbp-pilar2b load --target pilar2b`; user/password are the
# ones in NewLook's docker-compose.yml
# BBP_PILAR2B_DATABASE_URL=postgresql://<user>:<password>@cp2b-db-dev:5432/cp2b_maps

# --- optional ----------------------------------------------------------------
# Raw data folder on the host if it is not the parent of this repository
# BBP_RAW_HOST=C:/Users/<you>/Documents/Reposicionamento_Submissão_ESD
# Stamp the image with the commit: set before `docker compose build`
# GIT_COMMIT=
